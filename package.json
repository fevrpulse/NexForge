{
  "name": "nexforge-desktop",
  "version": "4.1.6",
  "description": "NexForge Desktop",
  "main": "main.js",
  "author": "fevrpulse",
  "repository": {
    "type": "git",
    "url": "https://github.com/fevrpulse/NexForge.git"
  },
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "cross-env NEXFORGE_DEV=1 electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"wait-on http://127.0.0.1:5173 && npm:dev:electron\"",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "build": "npm run build:renderer && electron-builder --win -c.forceCodeSigning=false",
    "release": "npm run build:renderer && electron-builder --win --publish always -c.forceCodeSigning=false"
  },
  "build": {
    "appId": "com.nexforge.app",
    "productName": "NexForge",
    "forceCodeSigning": false,
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "dist-renderer/**/*",
      "main.js",
      "preload.js",
      "game-tracker.js",
      "overlay.html",
      "overlay-preload.js",
      "auth.html",
      "auth-success.html",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/sax/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/universalify/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/argparse/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "fevrpulse",
        "repo": "NexForge",
        "releaseType": "release"
      }
    ],
    "artifactName": "${productName}-Setup.${ext}",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "NexForge",
      "signAndEditExecutable": false
    },
    "afterPack": "./build/afterPack.js",
    "afterAllArtifactBuild": "./build/afterAllArtifactBuild.js",
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "NexForge",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "NexForge",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "resedit": "^3.0.2",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0"
  }
}
