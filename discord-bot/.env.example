# Bot token: Discord Developer Portal → your app → Bot → Reset Token.
# Never commit the real .env file.
DISCORD_TOKEN=

# Application ID: Developer Portal → your app → General Information → Application ID.
CLIENT_ID=

# Optional. When set, slash commands register to this server immediately.
# Leave empty to register globally (can take up to an hour to show up).
# Enable Developer Mode in Discord, then right-click the server → Copy Server ID.
GUILD_ID=

# Channel that receives new-member greetings.
# Leave empty to use the server's system channel when one exists.
WELCOME_CHANNEL_ID=

# Optional role given to new members. Leave empty to skip role assignment.
# The bot's role must be above this role, and the bot needs Manage Roles.
WELCOME_ROLE_ID=
